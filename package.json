{
  "name": "alphabet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:import": "tsx prisma/import-suites.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "docs:links": "node scripts/check-doc-links.mjs",
    "encoding:check": "node scripts/check-text-encoding.mjs",
    "deps:check": "node scripts/check-exact-deps.mjs",
    "build:check": "echo R01-process-foundation: chore(config): test | npx commitlint",
    "cu:verify": "node scripts/cu-verify.mjs",
    "cu:commit": "node scripts/cu-commit.mjs",
    "phase:run": "node scripts/run-phase.mjs",
    "prepare": "node -e \"if(process.env.HUSKY==='0')process.exit(0);try{require('node:child_process').execSync('git rev-parse --git-dir',{stdio:'ignore'})}catch{process.exit(0)}require('node:child_process').execSync('husky',{stdio:'inherit'})\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": "eslint --fix"
  },
  "dependencies": {
    "@google/genai": "1.52.0",
    "@neondatabase/serverless": "0.10.4",
    "@next/third-parties": "16.2.6",
    "@prisma/adapter-neon": "7.8.0",
    "@prisma/client": "7.8.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "dotenv": "16.6.1",
    "framer-motion": "12.23.26",
    "lucide-react": "1.17.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/postcss": "4.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "5.8.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22 <26"
  }
}
